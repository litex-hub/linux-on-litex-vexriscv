# Gowin AE350: single hart, software kernel atomics and legacy Andes MMU.
# CONFIG_SMP is not set
CONFIG_RISCV_GOWIN_AE350=y
CONFIG_HZ_PERIODIC=y
# CONFIG_NO_HZ_IDLE is not set
CONFIG_HZ_100=y
CONFIG_PREEMPT_NONE=y
CONFIG_UNIX98_PTYS=y
# musl uses an AF_UNIX socket for interface-index queries.
CONFIG_UNIX=y
