+   version.
+
+   Under Section 7 of GPL version 3, you are granted additional
+   permissions described in the GCC Runtime Library Exception, version
+   3.1, as published by the Free Software Foundation.
+
+   You should have received a copy of the GNU General Public License and
+   a copy of the GCC Runtime Library Exception along with this program;
+   see the files COPYING3 and COPYING.RUNTIME respectively. If not, see
+   <http://www.gnu.org/licenses/>.  */
+#if __riscv_xlen == 32 && !defined(__riscv_atomic)
+static inline bool __attribute__((always_inline))
+ae350_compare_exchange (UWORD *ptr, UWORD *expected, UWORD desired,
+                        bool weak, int success, int failure)
+{
+  UWORD old, status, wanted = *expected;
+  __asm__ __volatile__ (
+    ".option push\n\t.option arch,+a\n\t"
+    "fence rw,rw\n"
+    "1: lw %0,0(%2)\n\tfence r,rw\n\t"
+    "lr.w.aqrl %0,(%2)\n\t"
+    "bne %0,%3,2f\n\t"
+    "sc.w.aqrl %1,%4,(%2)\n\t"
+    "bnez %1,1b\n"
+    "2: fence rw,rw\n\t.option pop"
+    : "=&r"(old), "=&r"(status)
+    : "r"(ptr), "r"(wanted), "r"(desired)
+    : "memory");
+  if (old == wanted)
+    return true;
+  *expected = old;
+  return false;
+}
+#define atomic_compare_exchange_w ae350_compare_exchange
+#if N == 4
+#define atomic_compare_exchange_n ae350_compare_exchange
+#endif
+#endif
+#include_next <host-config.h>
